{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "API Workbench",
  "version": "0.1.1",
  "identifier": "com.apiworkbench",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      { "title": "API Workbench", "width": 1280, "height": 820, "minWidth": 960, "minHeight": 600 }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}